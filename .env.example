# Copy to .env for local development. Never commit .env.
#
# Configuration keys nest with a double underscore: Email:MailerSend:ApiToken
# is Email__MailerSend__ApiToken, and ConnectionStrings:Sw5e is
# ConnectionStrings__Sw5e.

# ── Content ───────────────────────────────────────────────────────────────────
# Where the catalogue comes from.
#   file      an in-memory index built at startup from the JSON content files
#   database  PostgreSQL, populated by the migrator
# The default is `file`, which needs no database at all. Anything other than
# these two values is refused at startup rather than treated as the default, so
# a typo cannot quietly put a deployment on the wrong store.
Content__Store=file

# Directory holding one subdirectory per content type. Relative paths resolve
# against the application's content root. Read by the API in `file` mode, and by
# the migrator's import step in either mode.
Content__RootPath=../../../sw5e-database/content

# ── Database ──────────────────────────────────────────────────────────────────
# The platform connection string, and the one the content store uses. Required
# when Content__Store=database, and by the migrator always; unused otherwise.
#
# Accounts read their own (see below) and fall back to this one, so a small
# deployment can run everything through a single role while a larger one gives
# account data a role, or a database, with no rights over content at all.
#
# SECRET. The password belongs here and nowhere else: never in
# appsettings.json, never committed, never logged.
#ConnectionStrings__Sw5e=Host=localhost;Port=5432;Database=sw5e;Username=sw5e;Password=choose_a_local_password

# Optional connection tuning. The values in appsettings.json are the intended
# defaults; these exist so a deployment can move them without a rebuild.
#Sw5e__Database__CommandTimeoutSeconds=15
#Sw5e__Database__MaxRetryCount=3
#Sw5e__Database__MaxRetryDelaySeconds=5

# Whether the readiness probe reports a schema behind this build as degraded.
# On by default, and worth leaving on: nothing migrates on startup, so this is
# what catches a deploy that shipped code and forgot to run the migrator.
#Sw5e__Database__ReportPendingMigrations=true

# ── Email ─────────────────────────────────────────────────────────────────────
# Leave the whole section unset for local development. A Development host with
# no provider configured captures messages to the console — links included —
# and delivers nothing, so the application runs with no credentials at all.
#
# Outside Development, a missing provider or a missing credential stops the
# application at startup rather than letting it run and drop mail silently.
# See src/Sw5e.Email/README.md for every key.

# MailerSend | Smtp | Capture
#Email__Provider=MailerSend
#Email__FromAddress=noreply@example.com
#Email__FromName=SW5e
#Email__ReplyToAddress=support@example.com

# SECRET. Issued per sending domain in the MailerSend dashboard. Never commit a
# real value here or anywhere else.
#Email__MailerSend__ApiToken=

# Generic SMTP relay, used when Email__Provider=Smtp. Port 587 with STARTTLS;
# port 465 is not supported and is rejected at startup.
#Email__Smtp__Host=smtp.example.com
#Email__Smtp__Port=587
#Email__Smtp__UserName=
# SECRET. Same rules as the API token.
#Email__Smtp__Password=

# ── Accounts ──────────────────────────────────────────────────────────────────
# The API refuses to start without an identity connection string: an API that
# boots happily with no account system is one serving an unauthenticated site
# without saying so. Identity may have its own least-privileged role, with
# rights over nothing but the `identity` schema, or share the platform one.
#
# SECRET once a password is filled in. Same rules as every other credential
# here: never commit a real value.
ConnectionStrings__Sw5eIdentity=Host=localhost;Port=5432;Database=sw5e;Username=sw5e;Password=

# Where emailed verification and recovery links point. Configured rather than
# derived from the request: deriving it would let anyone who can set a Host
# header decide where an account recovery link goes.
Identity__PublicSiteUrl=http://localhost:5173

# The registrable domain passkeys are bound to — a bare domain, no scheme, no
# port, no path. Leave it unset for local development so the framework uses the
# request's own host; set it in every deployed environment. Changing it
# invalidates every passkey already registered.
#Identity__RelyingPartyId=sw5e.example

# Exact origins the browser application is served from, compared exactly. Leave
# unset when the site and the API share a hostname behind the reverse proxy,
# which is the common and safest case.
#Identity__AllowedOrigins__0=https://sw5e.example

# Applies migrations and seeds the roles during startup. Convenient locally;
# off in production, where migrations are a deliberate separate step.
Identity__InitializeDatabaseAtStartup=true

# ── Anti-abuse challenge ──────────────────────────────────────────────────────
# A self-hosted proof-of-work challenge in front of POST /api/auth/register and
# POST /api/auth/email/code — the two anonymous routes that make this platform
# write a row and send a message on a stranger's say-so. No third party and
# nothing loaded from anywhere else: the site's content security policy names no
# external host, and a hosted captcha would mean widening it for good.
#
# Off unless Enabled is set. Enabled without a usable secret stops the
# application at startup rather than letting it run believing it is protected.
#Auth__Challenge__Enabled=true

# SECRET. The HMAC key challenges are signed with; at least 32 characters, and
# the same value on every instance behind the load balancer, or an instance will
# refuse challenges its neighbour issued. There is no default and there will
# never be one — a signing key committed to a public repository lets anybody
# mint their own challenges. Generate one with:
#
#   openssl rand -base64 48
#
#Auth__Challenge__Secret=

# Leading zero BITS a solution must produce. 18 by default, refused at startup
# outside 8-24. Each bit doubles the work: 18 is well under a second on a phone,
# 24 is sixty-four times that and starts looking broken on a slow device.
#Auth__Challenge__Difficulty=18

# How long an issued challenge stays spendable.
#Auth__Challenge__Lifetime=00:10:00

# ── Accounts, continued ───────────────────────────────────────────────────────
# Promoted to administrator on the next start, if an account with this address
# exists. Creates nothing: the person registers through the ordinary public
# flow and proves control of the address like anybody else.
#Identity__BootstrapAdministratorEmail=you@example.com

