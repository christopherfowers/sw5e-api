<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="Shouldly" Version="4.3.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />

    <!-- The account tests run against a real PostgreSQL instance. The identity
         schema uses a JSON column, a non-default schema and a unique index the
         registration flow depends on; no substitute provider models all three,
         so a suite running against one would assert on behaviour the deployed
         system does not have. -->
    <PackageReference Include="Testcontainers.PostgreSql" Version="4.14.0" />

    <!-- WebAuthn carries attestation objects and public keys as CBOR. The
         virtual authenticator has to produce both. -->
    <PackageReference Include="System.Formats.Cbor" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The content fixture is committed here so the tests never depend on the
         sibling content repository being checked out beside this one. -->
    <Content Include="TestContent\**\*.json" CopyToOutputDirectory="PreserveNewest" />

    <!-- The real JSON Schemas, from the submodule, copied beside the test
         assembly.

         The authoring tests assert that a document violating its schema is
         refused and stores nothing. Asserting that against a schema written for
         the test would prove only that some validator rejects some document; it
         has to be the schema the corpus is actually held to, or the test does
         not cover the thing that matters. Copied rather than read in place so a
         test run does not depend on the working directory. -->
    <Content Include="..\..\external\sw5e-database\schemas\**\*.json"
             Link="TestSchemas\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sw5e.Api\Sw5e.Api.csproj" />
  </ItemGroup>

</Project>